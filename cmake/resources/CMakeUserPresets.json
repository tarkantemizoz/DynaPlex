{
  "version": 3,
  "configurePresets": [
    {
      "name": "win-base",
      "hidden": true,
      "cacheVariables": {
        "dynaplex_all_warnings": false,
        "DYNAPLEX_IO_ROOT_DIR": "C:/path/to/io_root",
        "CMAKE_INSTALL_PREFIX": "C:/path/to/dp_install"
      }
    },
    {
      "name": "lin-base",
      "hidden": true,
      "cacheVariables": {
        "dynaplex_all_warnings": false,
        "DYNAPLEX_IO_ROOT_DIR": "/path/to/io_root"
      }
    },
    {
      "name": "mac-user-base",
      "hidden": true,
      "cacheVariables": {
        "dynaplex_all_warnings": false,
        "DYNAPLEX_IO_ROOT_DIR": "/path/to/io_root"
      }
    },
    {
      "name": "MacRelNoTorch",
      "inherits": [ "mac-release", "mac-user-base" ],
      "cacheVariables": {
        "dynaplex_enable_pytorch": false,
        "dynaplex_enable_pythonbindings": false,
        "dynaplex_enable_tests": false
      }
    },
    {
      "name": "WinDeb",
      "inherits": [ "x64-debug", "win-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "C:/path/to/libtorch-debug/share/cmake",
        "dynaplex_enable_pytorch": false,
        "dynaplex_enable_pythonbindings": false,
        "dynaplex_enable_tests": true
      }
    },
    {
      "name": "WinRel",
      "inherits": [ "x64-release", "win-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "C:/path/to/libtorch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_tests": true
      }
    },
    {
      "name": "WinProf",
      "inherits": [ "x64-release", "win-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "C:/path/to/libtorch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_tests": true,
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "WinPB",
      "inherits": [ "x64-release", "win-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "C:/path/to/site-packages/torch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_pythonbindings": true,
        "dynaplex_pybind_path": "C:/path/to/site-packages/pybind11/share/cmake/pybind11",
        "dynaplex_python_path": "C:/path/to/python-env"
      }
    },
    {
      "name": "LinDeb",
      "inherits": [ "linux-debug", "lin-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "/path/to/libtorch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_pythonbindings": false,
        "dynaplex_enable_tests": true
      }
    },
    {
      "name": "LinRel",
      "inherits": [ "linux-release", "lin-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "/path/to/libtorch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_pythonbindings": false,
        "dynaplex_enable_mpi": false,
        "dynaplex_enable_tests": true
      }
    },
    {
      "name": "LinMPI",
      "inherits": [ "linux-release", "lin-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "/path/to/libtorch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_pythonbindings": false,
        "dynaplex_enable_mpi": true,
        "dynaplex_enable_tests": false
      }
    },
    {
      "name": "LinPB",
      "inherits": [ "linux-release", "lin-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "/path/to/site-packages/torch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_pythonbindings": true,
        "dynaplex_pybind_path": "/path/to/site-packages/pybind11/share/cmake/pybind11",
        "dynaplex_python_path": "/path/to/python-env",
        "dynaplex_enable_gurobi": false,
        "dynaplex_gurobi_path": ""
      }
    },
    {
      "name": "MacRel",
      "inherits": [ "mac-release", "mac-user-base" ],
      "cacheVariables": {
        "dynaplex_pytorch_path": "/path/to/libtorch/share/cmake",
        "dynaplex_enable_pytorch": true,
        "dynaplex_enable_pythonbindings": false,
        "dynaplex_enable_tests": false
      }
    },
    {
      "name": "WinDebCl",
      "inherits": [ "windows-base", "win-base" ],
      "cacheVariables": {
        "dynaplex_enable_pytorch": false,
        "dynaplex_enable_pythonbindings": false,
        "dynaplex_enable_tests": true,
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
