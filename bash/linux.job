#!/bin/bash
#SBATCH --time=10:00:00 --exclusive --nodes=1 --ntasks-per-node=1 --cpus-per-task=192 --partition genoa --mem=336G
set -euo pipefail

# usage: sbatch linux_run.job <executable> [args...]
#   PRESET=LinRel    (default; override with e.g. PRESET=LinMPI)
# Override sbatch directives at submit time, e.g.
#   sbatch --time=20:00:00 --nodes=2 linux_run.job lostsales_paper_results

if [ $# -lt 1 ]; then
    echo "usage: sbatch $0 <executable> [args...]" >&2
    exit 1
fi

EXE="$1"
shift
PRESET="${PRESET:-LinRel}"

# Resolve the script's real location (sbatch copies it to /var/spool/slurm/...,
# so $0 is unreliable). scontrol exposes the original submission path.
if [ -n "${SLURM_JOB_ID:-}" ] && command -v scontrol >/dev/null 2>&1; then
    SCRIPT_PATH="$(scontrol show job "$SLURM_JOB_ID" -o | sed -n 's/.*Command=\([^ ]*\).*/\1/p')"
else
    SCRIPT_PATH="$0"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="$REPO/out/$PRESET"
BIN_DIR="$BUILD_DIR/bin"
LOG_DIR="$REPO/bash/logs"
mkdir -p "$LOG_DIR"

STAMP=$(date +%Y%m%d_%H%M%S)
OUT="$LOG_DIR/${EXE}_${STAMP}.out"
ERR="$LOG_DIR/${EXE}_${STAMP}.err"

module load 2023
module load CMake/3.26.3-GCCcore-12.3.0
module load OpenMPI/4.1.5-GCC-12.3.0
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
module list

echo "[build] $EXE  (preset=$PRESET)"
cmake --build "$BUILD_DIR" --target "$EXE" -j

echo "[run]   $BIN_DIR/$EXE $*"
echo "[log]   $OUT"
cd "$BIN_DIR"
set +e
srun ./"$EXE" "$@" > "$OUT" 2> "$ERR"
STATUS=$?
set -e

if [ ! -s "$ERR" ]; then
    rm -f "$ERR"
    echo "[done]  exit=$STATUS"
else
    echo "[done]  exit=$STATUS  stderr=$ERR"
fi
exit $STATUS
